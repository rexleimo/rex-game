{
  "name": "rex-game",
  "version": "0.5.0",
    "private": true,
    "description": "rex-game — 可玩的民俗文化馆（部署 Gitee Pages）。含二十四节气、山海拾遗、圣杯、英歌、剪纸。",
  "scripts": {
    "dev": "next dev -p 3030",
    "dev:clean": "rm -rf .next && next dev -p 3030",
    "build": "next build",
    "start": "next start",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "assets:audit": "node scripts/assets-audit.mjs",
    "assets:check": "node scripts/assets-audit.mjs --check",
    "fonts": "bash scripts/fonts-subset.sh",
    "og": "node scripts/generate-og.mjs",
    "og:culture": "node --experimental-strip-types scripts/generate-culture-og.mjs",
    "scenes:jianzhi": "node scripts/generate-jianzhi-scenes.mjs",
    "lint": "next lint",
    "preview": "npm run build && npx serve out -l 3040"
  },
  "dependencies": {
    "@babylonjs/core": "^7.54.0",
    "@babylonjs/havok": "^1.3.13",
    "@babylonjs/loaders": "^7.54.3",
    "@babylonjs/materials": "^7.54.0",
    "@mediapipe/tasks-vision": "^0.10.22",
    "next": "^15.1.6",
    "phaser": "3.90.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "playwright-core": "1.51.1",
    "sharp": "0.34.5",
    "typescript": "^5.7.3"
  }
}
